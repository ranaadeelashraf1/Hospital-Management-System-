# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/medicare_hms?schema=public"

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET="replace-this-with-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# CORS — your frontend URL
CLIENT_URL="http://localhost:5173"

# SMTP email delivery (Gmail: use an App Password, not your normal password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@example.com"
SMTP_PASSWORD="your-smtp-app-password"
MAIL_FROM="MediCare <your-email@example.com>"
