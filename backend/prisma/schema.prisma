// MediCare Hospital Management System — Prisma schema
// Run `npx prisma generate` after installing, then `npx prisma db push`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URI")
}

// ────────────────────────────────
// Enums
// ────────────────────────────────

enum Role {
  ADMIN
  DOCTOR
  PATIENT
  RECEPTIONIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientStatus {
  ADMITTED
  OUTPATIENT
  DISCHARGED
}

enum DoctorStatus {
  AVAILABLE
  ON_LEAVE
  IN_SURGERY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BillingStatus {
  PAID
  UNPAID
  PENDING
}

// ────────────────────────────────
// Models
// ────────────────────────────────

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  phone        String?
  avatarUrl    String?  @map("avatar_url")
  emailVerified Boolean  @default(true) @map("email_verified")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  patient Patient?
  doctor  Doctor?
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  notifications Notification[]

  @@map("users")
}

model EmailVerificationToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @map("user_id") @db.ObjectId
  type        String
  title       String
  detail      String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notifications")
}

model Department {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  name         String  @unique
  headDoctorId String? @unique @map("head_doctor_id") @db.ObjectId

  headDoctor Doctor?    @relation("DepartmentHead", fields: [headDoctorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  doctors    Doctor[]   @relation("DoctorDepartment")
  patients   Patient[]

  @@map("departments")
}

model Patient {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  userId       String        @unique @map("user_id") @db.ObjectId
  age          Int
  gender       Gender
  bloodGroup   String?       @map("blood_group")
  address      String?
  departmentId String?       @map("department_id") @db.ObjectId
  status       PatientStatus @default(OUTPATIENT)
  admittedAt   DateTime?     @map("admitted_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?    @relation(fields: [departmentId], references: [id])
  appointments Appointment[]
  prescriptions Prescription[]
  billings     Billing[]

  @@map("patients")
}

model Doctor {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  userId           String       @unique @map("user_id") @db.ObjectId
  specialization   String
  experienceYears  Int          @map("experience_years")
  departmentId     String?      @map("department_id") @db.ObjectId
  availability     String?
  rating           Float        @default(0)
  status           DoctorStatus @default(AVAILABLE)
  createdAt        DateTime     @default(now()) @map("created_at")

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department?    @relation("DoctorDepartment", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  headOfDepartment   Department?    @relation("DepartmentHead")
  appointments       Appointment[]
  prescriptions      Prescription[]

  @@map("doctors")
}

model Appointment {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  patientId    String            @map("patient_id") @db.ObjectId
  doctorId     String            @map("doctor_id") @db.ObjectId
  apptDate     DateTime          @map("appt_date")
  apptTime     String            @map("appt_time")
  status       AppointmentStatus @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at")

  patient      Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor       Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  prescription Prescription?
  billing      Billing?

  @@map("appointments")
}

model Prescription {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String   @unique @map("appointment_id") @db.ObjectId
  patientId     String   @map("patient_id") @db.ObjectId
  doctorId      String   @map("doctor_id") @db.ObjectId
  diagnosis     String
  instructions  String?
  issuedDate    DateTime @default(now()) @map("issued_date")

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medicines   Medicine[]

  @@map("prescriptions")
}

model Medicine {
  id             String @id @default(auto()) @map("_id") @db.ObjectId
  prescriptionId String @map("prescription_id") @db.ObjectId
  name           String
  dosage         String
  duration       String

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("medicines")
}

model Billing {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  patientId     String        @map("patient_id") @db.ObjectId
  appointmentId String?       @unique @map("appointment_id") @db.ObjectId
  amount        Float
  status        BillingStatus @default(PENDING)
  invoiceDate   DateTime      @default(now()) @map("invoice_date")

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@map("billing")
}
